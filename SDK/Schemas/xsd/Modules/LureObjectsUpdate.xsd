<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="uri:ea.com:eala:asset" targetNamespace="uri:ea.com:eala:asset" elementFormDefault="qualified">
  <!-- GuardOffset count sets capacity. Public aliases retain native tokens;
       UpdateRate and DisabledTypesToProcess are recovered field names. -->
  <xs:complexType name="LureObjectsUpdateModuleData">
    <xs:complexContent><xs:extension base="UpdateModuleData">
      <xs:sequence><xs:element name="GuardOffset" type="Vector3" minOccurs="1" maxOccurs="unbounded"/></xs:sequence>
      <xs:attribute name="LureObjectLinkID" type="SageInt" default="0"/>
      <xs:attribute name="MaxRangeSquared" type="SageReal" default="1000000"/>
      <xs:attribute name="GuardRange" type="SageReal" default="99999"/>
      <xs:attribute name="GuardStatus" type="ObjectStatusBitFlags"/>
      <xs:attribute name="UpdateRate" type="SageInt" default="10"/>
      <xs:attribute name="TargetMarkerObjectRef" type="GameObjectWeakRef"/>
      <xs:attribute name="DisabledTypesToProcess" type="DisabledBitFlags"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>
</xs:schema>
