{
  "name": "newsdk-mod-tools",
  "displayName": "NewSdk Mod Tools",
  "description": "共享 XML/XSD 智能编辑、编译工作台和 CPU/GPU、Trail、Lightning、Swarm 特效编辑。",
  "version": "0.5.1",
  "publisher": "wu162",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/wu192/NewSdk.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/src/extension.js",
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "compile": "tsc -p . && node scripts/build-fx.cjs",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node --test out/test/*.test.js",
    "test:host": "npm run compile && node out/test/runHost.js",
    "package": "vsce package --allow-missing-repository --out NewSdk-Mod-Tools-FX.vsix",
    "test:render": "npm run compile && node test/renderFx.cjs && node test/renderFxRound2.cjs && node test/fxUiRound2.cjs && node test/renderFxSpecial.cjs && node test/fxAuthoringUi.cjs",
    "test:stress": "npm run compile && node --expose-gc test/fxStress.cjs",
    "test:languageHost": "npm run compile && node out/test/runLanguageHost.js"
  },
  "dependencies": {
    "https-proxy-agent": "^7.0.6",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.10.0",
    "@types/vscode": "1.96.0",
    "@types/yauzl": "^2.10.3",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "0.25.12",
    "typescript": "^5.7.2"
  },
  "contributes": {
    "taskDefinitions": [
      {
        "type": "newsdk",
        "required": [
          "runId",
          "operation"
        ],
        "properties": {
          "runId": {
            "type": "string",
            "description": "扩展创建的本轮任务标识。"
          },
          "operation": {
            "type": "string",
            "enum": [
              "doctor",
              "plan",
              "build"
            ]
          }
        }
      }
    ],
    "commands": [
      {
        "command": "newsdk.openWorkbench",
        "title": "NewSdk: 打开编译工作台"
      },
      {
        "command": "newsdk.selectProject",
        "title": "NewSdk: 选择 MOD 目录"
      },
      {
        "command": "newsdk.configure",
        "title": "NewSdk: 配置编译环境"
      },
      {
        "command": "newsdk.configureCompiler",
        "title": "NewSdk: 选择或下载编译器"
      },
      {
        "command": "newsdk.configureSdk",
        "title": "NewSdk: 设置 SDK 目录"
      },
      {
        "command": "newsdk.configureOutput",
        "title": "NewSdk: 设置输出目录"
      },
      {
        "command": "newsdk.setVersion",
        "title": "NewSdk: 设置 MOD 版本"
      },
      {
        "command": "newsdk.build",
        "title": "NewSdk: 编译 MOD",
        "icon": "$(play)"
      },
      {
        "command": "newsdk.stop",
        "title": "NewSdk: 停止编译（强制中断）",
        "icon": "$(debug-stop)"
      },
      {
        "command": "newsdk.plan",
        "title": "NewSdk: 查看编译计划"
      },
      {
        "command": "newsdk.doctor",
        "title": "NewSdk: 检查编译环境"
      },
      {
        "command": "newsdk.openLog",
        "title": "NewSdk: 查看编译日志"
      },
      {
        "command": "newsdk.openEvents",
        "title": "NewSdk: 查看完整事件 JSONL"
      },
      {
        "command": "newsdk.openReport",
        "title": "NewSdk: 查看构建报告"
      },
      {
        "command": "newsdk.openOutput",
        "title": "NewSdk: 打开输出目录"
      },
      {
        "command": "newsdk.openArtifact",
        "title": "NewSdk: 打开产物位置"
      },
      {
        "command": "newsdk.previewFx",
        "title": "NewSdk: 预览当前特效",
        "icon": "$(sparkle)"
      },
      {
        "command": "newsdk.searchFx",
        "title": "NewSdk: 搜索特效"
      },
      {
        "command": "newsdk.reloadFx",
        "title": "NewSdk: 重载特效资源",
        "icon": "$(refresh)"
      },
      {
        "command": "newsdk.newFx",
        "title": "NewSdk: 新建特效"
      },
      {
        "command": "newsdk.saveAndBuild",
        "title": "NewSdk: 保存并编译",
        "icon": "$(save-all)"
      },
      {
        "command": "newsdk.buildSaved",
        "title": "NewSdk: 编译已保存内容（可能与预览不同）"
      },
      {
        "command": "newsdk.configureBuildOptions",
        "title": "NewSdk: 设置项目编译选项"
      },
      {
        "command": "newsdk.xml.impact",
        "title": "NewSdk XML: 查看资产影响范围"
      },
      {
        "command": "newsdk.xml.references",
        "title": "NewSdk XML: 查看资产引用"
      },
      {
        "command": "newsdk.xml.copyToMod",
        "title": "NewSdk XML: 复制 SDK 资产到 MOD"
      },
      {
        "command": "newsdk.xml.searchAssets",
        "title": "NewSdk XML: 查找资产",
        "icon": "$(search)"
      },
      {
        "command": "newsdk.xml.unreferenced",
        "title": "NewSdk XML: 查找未引用资产（所有类型）"
      },
      {
        "command": "newsdk.xml.unreferencedType",
        "title": "NewSdk XML: 查找未引用资产（当前资产类型）"
      },
      {
        "command": "newsdk.xml.reindex",
        "title": "NewSdk XML: 重新索引工作区"
      },
      {
        "command": "newsdk.xml.indexReport",
        "title": "NewSdk XML: 查看索引报告"
      },
      {
        "command": "newsdk.xml.clearIndex",
        "title": "NewSdk XML: 清除 XML 索引缓存并重建"
      },
      {
        "command": "newsdk.fx.importSkill",
        "title": "NewSdk FX: 导入/更新创作 Skill"
      },
      {
        "command": "newsdk.fx.installSkill",
        "title": "NewSdk FX: 安装到 AI 助手"
      },
      {
        "command": "newsdk.fx.openSkill",
        "title": "NewSdk FX: 打开 Skill 文档"
      },
      {
        "command": "newsdk.fx.copySkillPrompt",
        "title": "NewSdk FX: 复制 Skill 聊天提示词"
      },
      {
        "command": "newsdk.fx.restoreSkill",
        "title": "NewSdk FX: 恢复 Skill 版本"
      },
      {
        "command": "newsdk.fx.uninstallSkill",
        "title": "NewSdk FX: 卸载本次 Skill 安装"
      },
      {
        "command": "newsdk.fx.aiNew",
        "title": "NewSdk FX: AI 新建特效",
        "icon": "$(sparkle)"
      },
      {
        "command": "newsdk.fx.aiModify",
        "title": "NewSdk FX: AI 修改当前特效",
        "icon": "$(edit)"
      },
      {
        "command": "newsdk.fx.check",
        "title": "NewSdk FX: 检查当前特效",
        "icon": "$(checklist)"
      },
      {
        "command": "newsdk.fx.importResult",
        "title": "NewSdk FX: 导入 AI 结果"
      },
      {
        "command": "newsdk.fx.copyPrompt",
        "title": "NewSdk FX: 复制当前特效创作提示词"
      },
      {
        "command": "newsdk.agent.start",
        "title": "NewSdk AI: 启动本地只读 MCP"
      },
      {
        "command": "newsdk.agent.stop",
        "title": "NewSdk AI: 停止本地只读 MCP"
      },
      {
        "command": "newsdk.agent.copyConfiguration",
        "title": "NewSdk AI: 复制 MCP 连接配置"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "newsdk",
          "title": "NewSdk",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "newsdk": [
        {
          "id": "newsdk.sidebar",
          "name": "MOD 编译",
          "contextualTitle": "NewSdk"
        },
        {
          "id": "newsdk.fx",
          "name": "特效",
          "contextualTitle": "NewSdk"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "newsdk.openWorkbench",
          "when": "view == newsdk.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "newsdk.build",
          "when": "view == newsdk.sidebar && !newsdk.running",
          "group": "navigation@2"
        },
        {
          "command": "newsdk.stop",
          "when": "view == newsdk.sidebar && newsdk.running",
          "group": "navigation@2"
        },
        {
          "command": "newsdk.searchFx",
          "when": "view == newsdk.fx",
          "group": "navigation@1"
        },
        {
          "command": "newsdk.reloadFx",
          "when": "view == newsdk.fx",
          "group": "navigation@2"
        },
        {
          "command": "newsdk.xml.searchAssets",
          "when": "view == newsdk.sidebar",
          "group": "newsdk.xml"
        },
        {
          "command": "newsdk.xml.unreferenced",
          "when": "view == newsdk.sidebar",
          "group": "newsdk.xml"
        },
        {
          "command": "newsdk.xml.indexReport",
          "when": "view == newsdk.sidebar",
          "group": "newsdk.xml"
        },
        {
          "command": "newsdk.fx.aiNew",
          "when": "view == newsdk.fx",
          "group": "newsdk.authoring"
        },
        {
          "command": "newsdk.fx.aiModify",
          "when": "view == newsdk.fx",
          "group": "newsdk.authoring"
        },
        {
          "command": "newsdk.fx.check",
          "when": "view == newsdk.fx",
          "group": "newsdk.authoring"
        },
        {
          "command": "newsdk.fx.importSkill",
          "when": "view == newsdk.fx",
          "group": "newsdk.authoring"
        },
        {
          "command": "newsdk.fx.installSkill",
          "when": "view == newsdk.fx",
          "group": "newsdk.authoring"
        }
      ],
      "editor/title": [
        {
          "command": "newsdk.previewFx",
          "when": "resourceExtname == .xml",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "newsdk.previewFx",
          "when": "resourceExtname == .xml",
          "group": "newsdk"
        }
      ],
      "commandPalette": [
        {
          "command": "newsdk.newFx",
          "when": "resourceExtname == .xml"
        }
      ],
      "editor/context": [
        {
          "command": "newsdk.xml.searchAssets",
          "when": "editorLangId == xml",
          "group": "newsdk.xml"
        },
        {
          "command": "newsdk.xml.unreferencedType",
          "when": "editorLangId == xml",
          "group": "newsdk.xml"
        },
        {
          "command": "newsdk.xml.indexReport",
          "when": "editorLangId == xml",
          "group": "newsdk.xml"
        },
        {
          "command": "newsdk.fx.aiModify",
          "when": "editorLangId == xml",
          "group": "newsdk.fx"
        },
        {
          "command": "newsdk.fx.check",
          "when": "editorLangId == xml",
          "group": "newsdk.fx"
        }
      ]
    },
    "configuration": {
      "title": "NewSdk Mod Tools",
      "properties": {
        "newsdk.compilerPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "NewModCompiler.exe 的完整路径。只保存到用户设置。"
        },
        "newsdk.sdkRoot": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "SDK 根目录。只保存到用户设置；未配置时读取已有项目预设。"
        },
        "newsdk.fxTextureBudgetMiB": {
          "type": "integer",
          "default": 32,
          "minimum": 16,
          "maximum": 256,
          "description": "特效CPU贴图缓存与解码预算（MiB）；4K完整mip贴图建议128，超预算暂停加载。"
        },
        "newsdk.xml.includeSdkXml": {
          "type": "boolean",
          "default": false,
          "description": "将 SDK SageXML/Art 中的 XML 纳入同一索引。关闭时仍保留 Include 可见的 SDK XML 及 manifest 元数据。"
        },
        "newsdk.xml.unknownReferenceSeverity": {
          "type": "string",
          "enum": [
            "warning",
            "information",
            "off"
          ],
          "default": "warning",
          "description": "完整索引中未解析静态引用的提示级别。索引未完成时始终标记待确认，动态表达式不视为确定错误。"
        },
        "newsdk.fxPythonPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Python 3 可执行文件完整路径；留空使用系统 python。仅在运行配方、Skill 检查或 V2 XSD 校验时调用。"
        },
        "newsdk.fxSchemaPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "FX V2 校验的 XSD 入口覆盖路径；留空自动使用所选 SDK 的编译器 schema 设置或 Schemas/xsd/CnC3Types.xsd。未配置 SDK 且未覆盖时跳过；需要 Python lxml。"
        }
      }
    },
    "customEditors": [
      {
        "viewType": "newsdk.fxEditor",
        "displayName": "NewSdk 特效工作区",
        "selector": [
          {
            "filenamePattern": "*.xml"
          }
        ],
        "priority": "option"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "newsdkAsset",
        "superType": "variable",
        "description": "NewSdk 资产 ID"
      },
      {
        "id": "newsdkReference",
        "superType": "variable",
        "description": "NewSdk 类型引用"
      },
      {
        "id": "newsdkDefine",
        "superType": "macro",
        "description": "NewSdk 宏"
      },
      {
        "id": "newsdkInclude",
        "superType": "string",
        "description": "NewSdk Include 路径"
      },
      {
        "id": "newsdkResource",
        "superType": "string",
        "description": "NewSdk 资源路径"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "xml",
        "scopes": {
          "newsdkAsset": [
            "variable.other.constant"
          ],
          "newsdkReference": [
            "variable.other"
          ],
          "newsdkDefine": [
            "entity.name.function.preprocessor"
          ],
          "newsdkInclude": [
            "string.quoted"
          ],
          "newsdkResource": [
            "string.quoted"
          ]
        }
      }
    ]
  }
}
