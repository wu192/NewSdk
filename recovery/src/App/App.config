<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="fix-neutral-assets" value="false"/>
    <add key="game-root" value=""/>
    <!-- A nonempty version supplies the BIG/SKUDEF version for every MOD;
         MOD/newmodcompiler.json and the command line override it. -->
    <add key="mod-version" value=""/>
    <add key="compile-fx" value="true"/>
    <add key="fxc" value=""/>
  </appSettings>
  <startup useLegacyV2RuntimeActivationPolicy="true"><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/></startup>
</configuration>
